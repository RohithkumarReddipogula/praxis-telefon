# Copy to .env and fill in locally. Never commit .env.

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech-to-text
DEEPGRAM_API_KEY=

# Text-to-speech: elevenlabs | cartesia
TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# LLM via OpenRouter. Default: Claude Haiku 5.5 without reasoning (fastest in M1 tests).
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
# none | minimal | low | medium | high. Haiku 5.5: none. Gemini 3.x Flash: low is the minimum.
LLM_REASONING_EFFORT=none

# App
DATABASE_PATH=./data/praxis.db
# de | en. Also sets the Deepgram STT language.
DEFAULT_LANGUAGE=de
LOG_LEVEL=INFO
