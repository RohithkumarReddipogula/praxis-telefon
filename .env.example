# Copy to .env and fill in locally. Never commit .env.

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech-to-text
DEEPGRAM_API_KEY=

# Text-to-speech: elevenlabs | cartesia
TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# LLM via OpenRouter. Default: Claude Haiku 5.5 with reasoning "low".
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
# none | minimal | low | medium | high. Gemini 3.x Flash: low is the minimum.
# Haiku 5.5: low. With none it spoke its reasoning before tool calls (5 per 75 live tests);
# with low none did, at +58 ms llm_ttft (docs/experiments/reasoning-leak.md).
LLM_REASONING_EFFORT=low

# App
DATABASE_PATH=./data/praxis.db
# de | en. Also sets the Deepgram STT language unless STT_LANGUAGE is set.
DEFAULT_LANGUAGE=de
# Empty, de, en or multi. multi hears English callers; opt-in until a voice test with
# non-native German (docs/experiments/stt-language.md).
STT_LANGUAGE=
# Only with STT_LANGUAGE=multi: comma list of de, en (Deepgram language_hint), e.g. de,en.
# Opt-in until a voice test with accented German (multi tagged it Telugu, 2026-11-07).
STT_LANGUAGE_HINT=
LOG_LEVEL=INFO

# Public demo (M5, agent/demo.py). On in the cloud image (Dockerfile), off locally.
DEMO_MODE=
# Secret for the keyed caller hash (HMAC); at least 16 characters, random. Set it only as
# a LiveKit Cloud secret; never reuse it elsewhere.
DEMO_HASH_KEY=
# Limits (defaults: 300 s per call, warning 60 s before, 3 calls per caller and day,
# 15 calls and 45 minutes per day overall, Europe/Berlin).
DEMO_MAX_CALL_S=
DEMO_WARN_BEFORE_S=
DEMO_CALLS_PER_CALLER=
DEMO_CALLS_PER_DAY=
DEMO_MINUTES_PER_DAY=
# Where the call counts are kept (the container's disk; reset on restart).
DEMO_USAGE_DB=
# Create the synthetic database at start if it is missing (the cloud container).
SEED_ON_START=
