# Copy to .env and fill in locally. Never commit .env.

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech-to-text
DEEPGRAM_API_KEY=

# Text-to-speech: elevenlabs | cartesia
TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# LLM (provider chosen in M1)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# App
DATABASE_PATH=./data/praxis.db
DEFAULT_LANGUAGE=de
LOG_LEVEL=INFO
